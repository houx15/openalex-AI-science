{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOpenAlexPublicSnapshot",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::openalex", "arn:aws:s3:::openalex/*"]
    },
    {
      "Sid": "ReadArxivRequesterPaysBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::arxiv", "arn:aws:s3:::arxiv/*"]
    },
    {
      "Sid": "ProjectWorkBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:GetBucketLocation", "s3:ListBucket",
        "s3:PutBucketPublicAccessBlock", "s3:PutLifecycleConfiguration", "s3:PutEncryptionConfiguration",
        "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"
      ],
      "Resource": ["arn:aws:s3:::oaai-phase0-596131721388", "arn:aws:s3:::oaai-phase0-596131721388/*"]
    },
    {
      "Sid": "AthenaQueriesInProjectWorkgroup",
      "Effect": "Allow",
      "Action": [
        "athena:CreateWorkGroup", "athena:GetWorkGroup",
        "athena:StartQueryExecution", "athena:StopQueryExecution", "athena:GetQueryExecution",
        "athena:GetQueryResults", "athena:GetQueryRuntimeStatistics", "athena:ListQueryExecutions",
        "athena:BatchGetQueryExecution", "athena:GetDataCatalog", "athena:GetDatabase",
        "athena:GetTableMetadata", "athena:ListDatabases", "athena:ListTableMetadata"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:596131721388:workgroup/oaai-phase0",
        "arn:aws:athena:us-east-1:596131721388:datacatalog/AwsDataCatalog"
      ]
    },
    {
      "Sid": "AthenaList",
      "Effect": "Allow",
      "Action": ["athena:ListWorkGroups"],
      "Resource": "*"
    },
    {
      "Sid": "GlueCatalogForProjectDatabases",
      "Effect": "Allow",
      "Action": [
        "glue:CreateDatabase", "glue:GetDatabase", "glue:GetDatabases",
        "glue:CreateTable", "glue:UpdateTable", "glue:DeleteTable", "glue:GetTable", "glue:GetTables",
        "glue:BatchCreatePartition", "glue:CreatePartition", "glue:GetPartition", "glue:GetPartitions",
        "glue:BatchGetPartition", "glue:BatchDeletePartition"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:596131721388:catalog",
        "arn:aws:glue:us-east-1:596131721388:database/openalex_*",
        "arn:aws:glue:us-east-1:596131721388:table/openalex_*/*"
      ]
    },
    {
      "Sid": "ReadOnlyCostVisibility",
      "Effect": "Allow",
      "Action": ["budgets:ViewBudget", "ce:GetCostAndUsage"],
      "Resource": "*"
    },
    {
      "Sid": "Ec2Describe",
      "Effect": "Allow",
      "Action": ["ec2:Describe*"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "Ec2LaunchTaggedInstanceOfAllowedTypes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:596131721388:instance/*",
      "Condition": {
        "StringEquals": {"aws:RequestTag/Project": "oaai"},
        "StringLike": {"ec2:InstanceType": ["c7i.2xlarge", "c7i.4xlarge", "c7i.8xlarge", "m7i.4xlarge", "c6i.4xlarge"]}
      }
    },
    {
      "Sid": "Ec2LaunchTaggedVolumeUpTo500GB",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:596131721388:volume/*",
      "Condition": {
        "StringEquals": {"aws:RequestTag/Project": "oaai"},
        "NumericLessThanEquals": {"ec2:VolumeSize": "500"}
      }
    },
    {
      "Sid": "Ec2LaunchAmazonImagesInDefaultNetwork",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:596131721388:subnet/*",
        "arn:aws:ec2:us-east-1:596131721388:security-group/*",
        "arn:aws:ec2:us-east-1:596131721388:network-interface/*"
      ],
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "Ec2TagOnlyAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:596131721388:instance/*",
        "arn:aws:ec2:us-east-1:596131721388:volume/*",
        "arn:aws:ec2:us-east-1:596131721388:network-interface/*"
      ],
      "Condition": {"StringEquals": {"ec2:CreateAction": "RunInstances"}}
    },
    {
      "Sid": "Ec2ManageOnlyProjectInstances",
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances", "ec2:StopInstances", "ec2:GetConsoleOutput"],
      "Resource": "arn:aws:ec2:us-east-1:596131721388:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "oaai"}}
    },
    {
      "Sid": "PassOnlyTheExtractionRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::596131721388:role/oaai-extract-ec2",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Sid": "AgentCannotLoosenItsOwnLimits",
      "Effect": "Deny",
      "Action": [
        "athena:UpdateWorkGroup", "athena:DeleteWorkGroup",
        "budgets:ModifyBudget", "budgets:DeleteBudgetAction",
        "s3:DeleteBucket", "s3:PutBucketPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoIamExceptPassingTheExtractionRole",
      "Effect": "Deny",
      "Action": "iam:*",
      "NotResource": "arn:aws:iam::596131721388:role/oaai-extract-ec2"
    },
    {
      "Sid": "NoChangesToTheExtractionRole",
      "Effect": "Deny",
      "NotAction": "iam:PassRole",
      "Resource": "arn:aws:iam::596131721388:role/oaai-extract-ec2"
    },
    {
      "Sid": "NoEc2OutsideUsEast1",
      "Effect": "Deny",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": "us-east-1"}}
    }
  ]
}
